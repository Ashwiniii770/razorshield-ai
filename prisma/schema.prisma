generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Currency {
  INR
  USD
}

enum PaymentMethod {
  Card
  UPI
  NetBanking
  Wallet
}

enum Decision {
  APPROVE
  REVIEW
  BLOCK
}

model Transaction {
  id                  String        @id @default(cuid())
  externalRef         String        @unique
  merchantName        String
  customerEmail       String
  amount              Float
  currency            Currency
  paymentMethod       PaymentMethod
  cardBin             String?
  cardLast4           String?
  ipAddress           String?
  ipCountry           String?
  binCountry          String?
  deviceFingerprint   String?
  isProxy             Boolean       @default(false)
  riskScore           Int
  decision            Decision
  analystOverride     Decision?
  triggeredRules      String
  featureContributions String
  aiExplanation       String
  createdAt           DateTime      @default(now())
  auditLogs           AuditLog[]

  @@index([createdAt])
  @@index([decision, createdAt])
  @@index([customerEmail, createdAt])
}

model RiskRule {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  category       String
  thresholdValue Float
  weight         Float
  enabled        Boolean  @default(true)
  description    String
  updatedAt      DateTime @updatedAt
}

model AuditLog {
  id            String      @id @default(cuid())
  transactionId String
  actor         String
  action        String
  notes         String?
  createdAt     DateTime    @default(now())
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId, createdAt])
}
